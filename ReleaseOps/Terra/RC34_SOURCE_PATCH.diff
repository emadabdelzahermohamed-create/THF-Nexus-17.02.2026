@@ -0,0 +1,27 @@
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+PROJECT=(ROOT/"project.godot").read_text(encoding="utf-8")
+PRESET=(ROOT/"export_presets.cfg").read_text(encoding="utf-8")
+GRADLE=(ROOT/"android/app/build.gradle").read_text(encoding="utf-8")
+ICON=ROOT/"web/static/icons/icon-512.png"
+
+def test_native_project_has_exportable_app_icon():
+    assert 'config/icon="res://web/static/icons/icon-512.png"' in PROJECT
+    assert ICON.is_file() and ICON.stat().st_size > 0
+
+def test_rc34_stage_and_android_api36_metadata():
+    assert 'stage="RC34"' in PROJECT
+    assert 'gradle_build/target_sdk="36"' in PRESET
+    assert 'version/code=42068' in PRESET
+    assert 'version/name="4.6.8-rc34"' in PRESET
+    assert 'package/unique_name="com.topherofit.thf.terra"' in PRESET
+    assert 'export_path="build/android/THF-Terra-rc34-test.aab"' in PRESET
+
+def test_fallback_gradle_metadata_matches_rc34_api36():
+    assert 'compileSdk 36' in GRADLE
+    assert 'targetSdk 36' in GRADLE
+    assert 'versionCode 42068' in GRADLE
+    assert "versionName '4.6.8-rc34'" in GRADLE
+
+def test_android_texture_export_readiness_retained():
+    assert 'textures/vram_compression/import_etc2_astc=true' in PROJECT
