@@ -0,0 +1,23 @@
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+PROJECT=(ROOT/"project.godot").read_text(encoding="utf-8")
+PRESET=(ROOT/"export_presets.cfg").read_text(encoding="utf-8")
+GRADLE=(ROOT/"android/app/build.gradle").read_text(encoding="utf-8")
+
+def test_android_etc2_astc_import_enabled():
+    assert "textures/vram_compression/import_etc2_astc=true" in PROJECT
+
+def test_project_stage_rc33():
+    assert 'stage="RC33"' in PROJECT
+
+def test_godot_android_preset_api36_and_rc33_version():
+    assert 'platform="Android"' in PRESET
+    assert 'gradle_build/target_sdk="36"' in PRESET
+    assert 'version/code=42067' in PRESET
+    assert 'version/name="4.6.7-rc33"' in PRESET
+
+def test_fallback_android_gradle_api36_and_rc33_version():
+    assert "compileSdk 36" in GRADLE
+    assert "targetSdk 36" in GRADLE
+    assert "versionCode 42067" in GRADLE
+    assert "versionName '4.6.7-rc33'" in GRADLE
