diff --git a/src/index.css b/src/index.css
--- a/src/index.css
+++ b/src/index.css
@@
-.tabs { display:flex; gap:8px; overflow-x:auto; padding:12px 0 18px; position:sticky; top:0; z-index:5; backdrop-filter:blur(14px); }
-.tab { white-space:nowrap; background:#091b2a; }
+.tabs { display:flex; gap:8px; overflow-x:auto; padding:12px 0 18px; position:sticky; top:0; z-index:5; backdrop-filter:blur(14px); scroll-snap-type:x proximity; scroll-padding-inline:12px; overscroll-behavior-inline:contain; scrollbar-width:thin; scrollbar-color:#55e6b6 rgba(9,27,42,.55); -webkit-overflow-scrolling:touch; }
+.tabs::-webkit-scrollbar{height:4px}.tabs::-webkit-scrollbar-track{background:rgba(9,27,42,.55);border-radius:999px}.tabs::-webkit-scrollbar-thumb{background:#55e6b6;border-radius:999px}
+.tab { white-space:nowrap; background:#091b2a; flex:0 0 auto; scroll-snap-align:start; }
+.tab:focus-visible { outline:3px solid #7dd3fc; outline-offset:2px; }
@@
+@media(max-width:820px){.tabs{padding-inline:14px;margin-inline:-14px;mask-image:linear-gradient(to right,transparent 0,#000 14px,#000 calc(100% - 14px),transparent 100%);-webkit-mask-image:linear-gradient(to right,transparent 0,#000 14px,#000 calc(100% - 14px),transparent 100%)}}
