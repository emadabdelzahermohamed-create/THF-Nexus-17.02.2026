+.controls{display:grid;gap:10px}
+.row{display:grid;grid-template-columns:1fr auto;gap:8px}
+select,button{min-height:48px;border-radius:14px;border:1px solid #334155;background:#0f172a;color:#f8fafc;padding:0 14px;font:inherit}
+button{font-weight:800;cursor:pointer} button.primary{background:#0891b2;border-color:#22d3ee}
+.quick{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:7px}
+.quick button{min-height:42px;padding:0 6px;font-size:12px}
+.note{margin:0;color:#94a3b8;font-size:12px;line-height:1.45;text-align:center}
+@media(max-width:520px){.quick{grid-template-columns:repeat(3,1fr)}.stage,model-viewer{min-height:52vh}}
+</style>
+</head>
+<body>
+<main>
+<header>
+<div><div class="eyebrow" data-i18n="eyebrow">Offline Motion Coach</div><h1 data-i18n="title">Stage16A stays with you.</h1></div>
+<div class="badge" id="clipCount">Loading…</div>
+</header>
+<section class="stage" aria-label="3D exercise demonstration">
+<model-viewer id="coach" src="offline/stage16a.glb" camera-controls autoplay animation-name="breathe"
+shadow-intensity="1.15" shadow-softness=".85" exposure="1.05" interaction-prompt="none"
+camera-orbit="0deg 82deg 3.1m" min-camera-orbit="auto auto 1.6m" max-camera-orbit="auto auto 5m">
+</model-viewer>
+<div class="status" id="status" role="status">Preparing the offline coach…</div>
+</section>
+<section class="controls">
+<div class="row">
+<select id="animation" aria-label="Animation clip"></select>
+<button class="primary" id="replay" type="button" data-i18n="replay">Replay</button>
+</div>
+<div class="quick" aria-label="Quick motions">
+<button data-clip="breathe">Breathe</button>
+<button data-clip="walk">Walk</button>
+<button data-clip="run">Run</button>
+<button data-clip="UAL1_Push_Loop">Push</button>
+<button data-clip="UAL1_Jump_Loop">Jump</button>
+</div>
+<button id="retry" type="button" data-i18n="retry">Reconnect to full Top Hero Fit</button>
+<p class="note" data-i18n="note">This offline guide demonstrates stored motion only. Sensor/form verification and account sync require supported permissions and connectivity.</p>
+</section>
+</main>
+<script>
+const model=document.getElementById('coach'), select=document.getElementById('animation');
+const status=document.getElementById('status'), count=document.getElementById('clipCount');
+const ar=(navigator.language||'').toLowerCase().startsWith('ar');
+const t=ar?{
+eyebrow:'مدرب الحركة بدون إنترنت',title:'Stage16A متاح معك بدون إنترنت.',replay:'إعادة',
+retry:'إعادة الاتصال بـ Top Hero Fit',note:'هذا الدليل يعرض الحركة المخزنة فقط. التحقق بالحساسات ومزامنة الحساب يحتاجان الصلاحيات والاتصال.',
+ready:n=>`جاهز — ${n} حركة محلية`,playing:n=>`الحركة الحالية: ${n}`
+}:{
+eyebrow:'Offline Motion Coach',title:'Stage16A stays with you.',replay:'Replay',
+retry:'Reconnect to full Top Hero Fit',note:'This offline guide demonstrates stored motion only. Sensor/form verification and account sync require supported permissions and connectivity.',
+ready:n=>`Ready — ${n} local motions`,playing:n=>`Playing: ${n}`
+};
+if(ar){document.documentElement.lang='ar';document.documentElement.dir='rtl'}
+document.querySelectorAll('[data-i18n]').forEach(el=>{const k=el.dataset.i18n;if(typeof t[k]==='string')el.textContent=t[k]});
+function play(name){
+ if(!name)return;
+ model.animationName=name; model.currentTime=0; model.play();
+ select.value=name; status.textContent=t.playing(name);
+}
+model.addEventListener('load',()=>{
+ const clips=model.availableAnimations||[];
+ select.innerHTML='';
+ clips.forEach(name=>{const o=document.createElement('option');o.value=name;o.textContent=name;select.appendChild(o)});
+ const preferred=clips.includes('UAL1_Push_Loop')?'UAL1_Push_Loop':clips.includes('breathe')?'breathe':clips[0];
+ count.textContent=`${clips.length} clips`;status.textContent=t.ready(clips.length);play(preferred);
+});
+model.addEventListener('error',()=>{status.textContent=ar?'تعذر تحميل نموذج الحركة المحلي.':'Offline motion model failed to load.'});
+select.addEventListener('change',()=>play(select.value));
+document.getElementById('replay').addEventListener('click',()=>play(select.value));
+document.querySelectorAll('[data-clip]').forEach(b=>b.addEventListener('click',()=>play(b.dataset.clip)));
+document.getElementById('retry').addEventListener('click',()=>location.href='topherofit://retry');
+</script>
+</body>
+</html>
