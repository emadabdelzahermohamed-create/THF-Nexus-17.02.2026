{
  "openapi": "3.1.0",
  "info": {
    "title": "Top Hero Fit Fitness V2 API",
    "version": "0.2.0"
  },
  "servers": [
    {
      "url": "https://api.topherofit.com"
    }
  ],
  "security": [
    {
      "BearerAuth": []
    }
  ],
  "paths": {
    "/api/v2/workouts/sync": {
      "post": {
        "operationId": "syncWorkout",
        "summary": "Idempotently insert or version-update an authenticated user's workout",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 120
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/WorkoutSession"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Inserted, updated, duplicate, or stale",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session"
          },
          "409": {
            "description": "Idempotency conflict or stable record/version reused with different workout facts"
          },
          "422": {
            "description": "Invalid workout contract"
          }
        }
      }
    },
    "/api/v2/workouts": {
      "get": {
        "operationId": "listWorkoutHistory",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Authenticated user's workout history",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WorkoutHistory"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session"
          }
        }
      }
    },
    "/api/v2/progress/summary": {
      "get": {
        "operationId": "getProgressSummary",
        "responses": {
          "200": {
            "description": "Server-computed volume and personal records",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgressSummary"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid session"
          }
        }
      }
    },
    "/api/v2/competitions/{competitionId}/submissions": {
      "post": {
        "operationId": "submitCompetitionWorkout",
        "summary": "Submit a stored workout ID; score is derived server-side and remains unverified",
        "parameters": [
          {
            "name": "competitionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompetitionSubmissionRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Server-recorded score accepted; not physically verified",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionSubmissionResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer session"
          },
          "404": {
            "description": "Competition not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionError"
                }
              }
            }
          },
          "409": {
            "description": "Submission rejected, duplicate conflict, or event/member gate not met",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionSubmissionResult"
                }
              }
            }
          },
          "422": {
            "description": "Invalid submission request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/admin/competitions": {
      "post": {
        "operationId": "createCompetition",
        "summary": "Create a strength-training competition; requires the owner-managed admin key",
        "parameters": [
          {
            "name": "X-THF-Competition-Admin-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CompetitionDefinition"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Competition created",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Competition"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer session"
          },
          "403": {
            "description": "Admin key rejected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid competition definition",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionError"
                }
              }
            }
          },
          "503": {
            "description": "Competition administration is disabled until the owner key is configured",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/competitions": {
      "get": {
        "operationId": "listCompetitions",
        "summary": "List competition definitions and the authenticated user's enrollment state",
        "responses": {
          "200": {
            "description": "Competition list",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionList"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer session"
          }
        }
      }
    },
    "/api/v2/competitions/{competitionId}": {
      "get": {
        "operationId": "getCompetition",
        "summary": "Get one competition",
        "parameters": [
          {
            "name": "competitionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Competition details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Competition"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer session"
          },
          "404": {
            "description": "Competition not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/competitions/{competitionId}/join": {
      "post": {
        "operationId": "joinCompetition",
        "summary": "Enroll the authenticated user in a scheduled or active competition",
        "parameters": [
          {
            "name": "competitionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "User joined or was already enrolled",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionJoinResult"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer session"
          },
          "404": {
            "description": "Competition not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionError"
                }
              }
            }
          },
          "409": {
            "description": "Competition ended or participant capacity is full",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionJoinResult"
                }
              }
            }
          }
        }
      }
    },
    "/api/v2/competitions/{competitionId}/leaderboard": {
      "get": {
        "operationId": "getCompetitionLeaderboard",
        "summary": "Get a pseudonymous, server-recorded strength-volume leaderboard",
        "parameters": [
          {
            "name": "competitionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 50
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Pseudonymous leaderboard; reward eligibility is always false",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionLeaderboard"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid bearer session"
          },
          "404": {
            "description": "Competition not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionError"
                }
              }
            }
          },
          "422": {
            "description": "Invalid leaderboard limit",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CompetitionError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "short-lived access token"
      }
    },
    "schemas": {
      "WorkoutSet": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "exerciseId",
          "ordinal",
          "setType",
          "reps",
          "loadKg",
          "restSeconds"
        ],
        "properties": {
          "exerciseId": {
            "type": "string",
            "minLength": 1
          },
          "ordinal": {
            "type": "integer",
            "minimum": 1
          },
          "setType": {
            "enum": [
              "warmup",
              "working",
              "drop",
              "failure"
            ]
          },
          "reps": {
            "type": "integer",
            "minimum": 0
          },
          "loadKg": {
            "type": "number",
            "minimum": 0
          },
          "restSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "rpe": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          },
          "rir": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0,
            "maximum": 10
          }
        }
      },
      "WorkoutSession": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "clientRecordId",
          "clientRecordVersion",
          "startedAt",
          "endedAt",
          "sport",
          "exerciseSessionType",
          "source",
          "sets"
        ],
        "properties": {
          "clientRecordId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120
          },
          "clientRecordVersion": {
            "type": "integer",
            "minimum": 1
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sport": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "exerciseSessionType": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "enum": [
              "THF_ANDROID",
              "THF_WEB",
              "HEALTH_CONNECT"
            ]
          },
          "provenancePackage": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 200
          },
          "sets": {
            "type": "array",
            "maxItems": 1000,
            "items": {
              "$ref": "#/components/schemas/WorkoutSet"
            }
          }
        }
      },
      "SyncResult": {
        "type": "object",
        "required": [
          "result",
          "clientRecordId",
          "serverRevision"
        ],
        "properties": {
          "result": {
            "enum": [
              "inserted",
              "updated",
              "duplicate",
              "stale"
            ]
          },
          "clientRecordId": {
            "type": "string"
          },
          "serverRevision": {
            "type": "integer"
          }
        }
      },
      "WorkoutHistoryItem": {
        "type": "object",
        "required": [
          "clientRecordId",
          "clientRecordVersion",
          "startedAt",
          "endedAt",
          "sport",
          "exerciseSessionType",
          "source",
          "volumeKg",
          "sets"
        ],
        "properties": {
          "clientRecordId": {
            "type": "string"
          },
          "clientRecordVersion": {
            "type": "integer"
          },
          "startedAt": {
            "type": "string",
            "format": "date-time"
          },
          "endedAt": {
            "type": "string",
            "format": "date-time"
          },
          "sport": {
            "type": "string"
          },
          "exerciseSessionType": {
            "type": "integer"
          },
          "source": {
            "enum": [
              "THF_ANDROID",
              "THF_WEB",
              "HEALTH_CONNECT"
            ]
          },
          "provenancePackage": {
            "type": [
              "string",
              "null"
            ]
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          },
          "volumeKg": {
            "type": "number",
            "minimum": 0
          },
          "sets": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkoutSet"
            }
          }
        }
      },
      "WorkoutHistory": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WorkoutHistoryItem"
            }
          }
        }
      },
      "ProgressSummary": {
        "type": "object",
        "required": [
          "workouts",
          "volumeKg",
          "personalRecords"
        ],
        "properties": {
          "workouts": {
            "type": "integer",
            "minimum": 0
          },
          "volumeKg": {
            "type": "number",
            "minimum": 0
          },
          "personalRecords": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "exerciseId",
                "maxLoadKg"
              ],
              "properties": {
                "exerciseId": {
                  "type": "string"
                },
                "maxLoadKg": {
                  "type": "number",
                  "minimum": 0
                }
              }
            }
          }
        }
      },
      "CompetitionDefinition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "sport",
          "metric",
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,119}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "sport": {
            "type": "string",
            "const": "strength_training"
          },
          "metric": {
            "type": "string",
            "const": "strength_volume_kg_reps"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "maxParticipants": {
            "oneOf": [
              {
                "type": "integer",
                "const": 0
              },
              {
                "type": "integer",
                "minimum": 2,
                "maximum": 100000
              }
            ],
            "default": 0
          }
        }
      },
      "Competition": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "title",
          "sport",
          "metric",
          "metricUnit",
          "startsAt",
          "endsAt",
          "status",
          "maxParticipants",
          "participantCount",
          "verificationLevel",
          "rewardEligible"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "sport": {
            "type": "string",
            "const": "strength_training"
          },
          "metric": {
            "type": "string",
            "const": "strength_volume_kg_reps"
          },
          "metricUnit": {
            "type": "string",
            "const": "kg·reps"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "type": "string",
            "enum": [
              "scheduled",
              "active",
              "completed"
            ]
          },
          "maxParticipants": {
            "oneOf": [
              {
                "type": "integer",
                "const": 0
              },
              {
                "type": "integer",
                "minimum": 2,
                "maximum": 100000
              }
            ]
          },
          "participantCount": {
            "type": "integer",
            "minimum": 0
          },
          "verificationLevel": {
            "type": "string",
            "const": "SERVER_RECORDED_NOT_PHYSICALLY_VERIFIED"
          },
          "rewardEligible": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "CompetitionListItem": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Competition"
          },
          {
            "type": "object",
            "required": [
              "joined"
            ],
            "properties": {
              "joined": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "CompetitionList": {
        "type": "object",
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompetitionListItem"
            }
          }
        }
      },
      "CompetitionJoinResult": {
        "type": "object",
        "required": [
          "joined"
        ],
        "properties": {
          "joined": {
            "type": "boolean"
          },
          "alreadyJoined": {
            "type": "boolean"
          },
          "competitionId": {
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "COMPETITION_ENDED",
              "COMPETITION_FULL"
            ]
          }
        }
      },
      "CompetitionSubmissionRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "workoutClientRecordId"
        ],
        "properties": {
          "workoutClientRecordId": {
            "type": "string",
            "minLength": 8,
            "maxLength": 120
          }
        }
      },
      "CompetitionSubmissionResult": {
        "type": "object",
        "required": [
          "accepted",
          "reason",
          "competitionId"
        ],
        "properties": {
          "accepted": {
            "type": "boolean"
          },
          "duplicate": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "enum": [
              "NOT_ENROLLED",
              "WORKOUT_NOT_FOUND",
              "SPORT_MISMATCH",
              "UNSUPPORTED_WORKOUT_SOURCE",
              "WORKOUT_OUTSIDE_COMPETITION_WINDOW",
              "NO_SCOREABLE_WORKING_VOLUME",
              "SERVER_RECORDED_SCORE",
              "ALREADY_RECORDED"
            ]
          },
          "competitionId": {
            "type": "string"
          },
          "metric": {
            "type": "string",
            "const": "strength_volume_kg_reps"
          },
          "metricValue": {
            "type": "number",
            "minimum": 0
          },
          "metricUnit": {
            "type": "string",
            "const": "kg·reps"
          },
          "verificationLevel": {
            "type": "string",
            "const": "SERVER_RECORDED_NOT_PHYSICALLY_VERIFIED"
          },
          "rewardEligible": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "CompetitionLeaderboardEntry": {
        "type": "object",
        "required": [
          "rank",
          "participantId",
          "metricValue",
          "metricUnit",
          "submissionCount",
          "verificationLevel",
          "rewardEligible"
        ],
        "properties": {
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "participantId": {
            "type": "string",
            "pattern": "^athlete-[a-f0-9]{12}$"
          },
          "metricValue": {
            "type": "number",
            "minimum": 0
          },
          "metricUnit": {
            "type": "string",
            "const": "kg·reps"
          },
          "submissionCount": {
            "type": "integer",
            "minimum": 1
          },
          "verificationLevel": {
            "type": "string",
            "const": "SERVER_RECORDED_NOT_PHYSICALLY_VERIFIED"
          },
          "rewardEligible": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "CompetitionLeaderboard": {
        "type": "object",
        "required": [
          "competition",
          "metric",
          "entries",
          "rewardEligible"
        ],
        "properties": {
          "competition": {
            "$ref": "#/components/schemas/Competition"
          },
          "metric": {
            "type": "string",
            "const": "strength_volume_kg_reps"
          },
          "entries": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CompetitionLeaderboardEntry"
            }
          },
          "rewardEligible": {
            "type": "boolean",
            "const": false
          }
        }
      },
      "CompetitionError": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "detail": {
            "type": "string"
          }
        }
      }
    }
  }
}
